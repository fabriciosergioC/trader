{
  "name": "trading-system-master",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && node server.js",
    "frontend": "cd \"front end\" && npm run dev",
    "build": "cd \"front end\" && npm run build",
    "postinstall": "npm install --prefix backend && npm install --prefix \"front end\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
